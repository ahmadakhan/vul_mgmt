[Unit]
Description=VulnStream Enterprise threat-intelligence pipeline (supervised)
Documentation=https://kilo.ai/docs
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
# Install the repository here and point this at the checked-out tree.
WorkingDirectory=/opt/vulnstream
# Production credentials and runtime config. Create .env.production (not committed).
EnvironmentFile=-/opt/vulnstream/.env.production
# The supervisor restarts the app process on crash with backoff; systemd
# restarts the supervisor itself if it ever exits, so the instance is always
# being supervised.
ExecStart=/usr/bin/node /opt/vulnstream/scripts/supervisor.mjs
Restart=always
RestartSec=5
StartLimitBurst=10
StartLimitIntervalSec=60

# Dedicated, unprivileged application user. Create it before enabling the service.
User=vulnstream
Group=vulnstream

# Process hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/vulnstream/data /opt/vulnstream/tmp /tmp
LimitCORE=0

# Structured JSON lines on stdout/stderr go to the journal; ship the journal to
# your log collector and retain independently of the database.
StandardOutput=journal
StandardError=journal

# Do not restart faster than the supervisor's own backoff allows.
# The application does not implement sd_notify watchdog pings; leave
# WatchdogSec unset so systemd does not mistake silence for death.

[Install]
WantedBy=multi-user.target
