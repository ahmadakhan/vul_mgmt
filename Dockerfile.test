FROM node:26-alpine3.22 AS test-base

WORKDIR /app

RUN apk add --no-cache \
    chromium \
    postgresql-client \
    python3 \
    make \
    g++

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

COPY package*.json ./

RUN npm ci --include=dev

COPY . .

RUN npm run lint

CMD ["npm", "run", "test:vitest"]
